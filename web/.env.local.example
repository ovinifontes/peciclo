# Modelo do arquivo `web/.env.local` (que nunca vai para o git).
# Copie este arquivo para `.env.local` e preencha os dois valores vazios.
#
# Onde pegar: Supabase → Settings → API Keys.
# O projeto usa as chaves NOVAS (formato `sb_publishable_...` / `sb_secret_...`),
# não as legadas `anon` / `service_role`.

# URL do projeto — pode aparecer no navegador, é pública.
NEXT_PUBLIC_SUPABASE_URL=https://qafcxvdrrwcmnyedvyts.supabase.co

# Chave publicável. Vai para o navegador de propósito; quem protege os dados
# por trás dela é o RLS, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave secreta. Ignora o RLS por completo, então só pode ser lida no servidor.
# ⚠️ NUNCA renomeie para NEXT_PUBLIC_* — o prefixo a embutiria no bundle do
# navegador e entregaria acesso total ao banco para qualquer visitante.
SUPABASE_SECRET_KEY=sb_secret_...
