# Copie este arquivo para `.env` (que fica fora do git) e preencha com os valores
# reais. NUNCA coloque segredos aqui no .env.example — ele é versionado.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev → dashboard do projeto
TRIGGER_PROJECT_REF=

# Instância da Evolution API
EVOLUTION_BASE_URL=https://evo.seudominio.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=

# WhatsApp — números em DDI+DDD+numero, só dígitos. Destinatários separados por vírgula.
WHATSAPP_DESTINATARIOS=5567999999999
WHATSAPP_OPERADOR=5567999999999

# Credencial do INDEA (MT)
INDEA_CPF=
INDEA_SENHA=

# Google Cloud → API key com a Drive API v3 habilitada (ver README para o passo a passo)
GOOGLE_API_KEY=

# Proxy do MS (Edge Function do Supabase) — só em produção (nuvem estrangeira).
# No dev local, com IP brasileiro, deixe vazio que ele vai direto no IAGRO.
MS_PROXY_URL=
MS_PROXY_SECRET=
